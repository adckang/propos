<mxfile host="app.diagrams.net"><diagram name="PROPOS ERD (요약)" id="propos-erd-summary"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#f0f4f8"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_property_cleaning_config" value="&lt;b&gt;property_cleaning_config&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;숙소 마스터 (정본)&lt;/font&gt;&lt;/i&gt;&lt;hr/&gt;&lt;b&gt;* property_id : text  ● PK&lt;/b&gt;&lt;br/&gt;name : text  ◇ UQ&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;… 그 밖의 칼럼 12개&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e0f2fe;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="576" y="40" width="220" height="108" as="geometry"/></mxCell><mxCell id="t_cleaners" value="&lt;b&gt;cleaners&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;청소 담당자 마스터&lt;/font&gt;&lt;/i&gt;&lt;hr/&gt;&lt;b&gt;* id : uuid  ● PK&lt;/b&gt;&lt;br/&gt;phone : text  ◇ UQ&lt;br/&gt;email : text  ◇ UQ&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;… 그 밖의 칼럼 10개&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e0f2fe;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2471" y="40" width="220" height="126" as="geometry"/></mxCell><mxCell id="t_operators" value="&lt;b&gt;operators&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;운영자 계정 (로그인)&lt;/font&gt;&lt;/i&gt;&lt;hr/&gt;&lt;b&gt;* id : uuid  ● PK&lt;/b&gt;&lt;br/&gt;email : text  ◇ UQ&lt;br/&gt;&lt;font color=&quot;#64748b&quot;&gt;… 그 밖의 칼럼 4개&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ede9fe;strokeColor=#94a3b8;fontColor=#