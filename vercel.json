{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/morning", "schedule": "0 23 * * *" },
    { "path": "/api/cron/evening", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/c/:id",
      "destination": "/api/cleaning/c?id=:id&slug=c"
    },
    {
      "source": "/api/d/:token",
      "destination": "/api/cleaning/d?token=:token&slug=d"
    },
    {
      "source": "/api/calendar/webhook",
      "destination": "/api/cleaning/calendar-webhook?slug=calendar-webhook"
    },
    {
      "source": "/api/gmail/webhook",
      "destination": "/api/cleaning/gmail-webhook?slug=gmail-webhook"
    },
    {
      "source": "/api/gmail/watch",
      "destination": "/api/cleaning/gmail-watch?slug=gmail-watch"
    },
    {
      "source": "/:path((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/ha/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/ical",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}