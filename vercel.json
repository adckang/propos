{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/daily-plan",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/daily-result",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/monthly-cleaning",
      "schedule": "0 0 15 * *"
    },
    {
      "path": "/api/cron/cleaning-followup",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/ha/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/ical",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
