# Vercel Project Settings -> Environment Variables
# 로컬과 동일하게 숙소별 REAL/SIMULATED를 함께 조회한다.
PROPOS_DATA_PROFILE=hybrid
# 운영에서 테스트용 상태 초기화 API는 기본 비활성
PROPOS_ENABLE_TEST_MUTATIONS=false
PROPOS_HA_BASE_URL=http://192.168.45.76:8123
PROPOS_HA_WS_URL=ws://192.168.45.76:8123/api/websocket
PROPOS_HA_TOKEN=YOUR_HA_LONG_LIVED_ACCESS_TOKEN
